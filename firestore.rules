rules_version = '2';
// Regras do Cloud Firestore do Meu Cronograma de Estudo.
// Cole no console do Firebase › Firestore Database › Regras e troque o e-mail do admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // Progresso de cada pessoa: só ela lê e grava.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Modelos da comunidade: todo mundo lê; só o autor cria, edita e apaga; o admin também apaga.
    match /modelos/{id} {
      function valido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['autor','autorNome','nome','cargo','banca','prova','hora','local','ano','links','materias','atualizado','criado'])
          && d.autor == request.auth.uid
          && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
          && d.materias is string && d.materias.size() < 300000;
      }
      allow read: if true;
      allow create: if request.auth != null && valido();
      allow update: if request.auth != null && resource.data.autor == request.auth.uid && valido();
      allow delete: if request.auth != null && (resource.data.autor == request.auth.uid
        || (request.auth.token.email == 'EMAIL_DO_ADMIN' && request.auth.token.email_verified == true));
    }
  }
}
